### ============================================================================
### English Word App - AI Chat API HTTP测试用例
### ============================================================================
### 测试环境: http://localhost:8885/api
### 创建时间: 2026-02-10
### ============================================================================

### ============================================================================
### 0. 准备工作 - 登录获取Token
### ============================================================================
# Name: 登录获取Token
# Method: POST
# Description: 先注册/登录获取JWT Token，后续请求需要使用
POST http://localhost:8885/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "test123"
}

> {%
    client.test("保存Token", function() {
        client.global.set("auth_token", response.body.data.token);
        client.global.set("user_id", response.body.data.userId);
        client.log("✅ Token已保存: " + response.body.data.token.substring(0, 20) + "...");
        client.log("✅ UserId已保存: " + response.body.data.userId);
    });
%}

###

### ============================================================================
### 1. AI对话接口 - Word Inquiry模式（单词讲解）
### ============================================================================
# Name: 测试1-1: 单词讲解 - serendipity
# Method: POST
# Description: 测试AI单词讲解功能
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "请详细讲解单词：serendipity",
  "conversationId": "",
  "mode": "word_inquiry",
  "targetWord": "serendipity"
}

> {%
    client.test("验证AI响应", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.message !== null, "AI消息不应为空");
        client.assert(response.body.data.message.length > 50, "AI响应应该足够详细");
        client.log("✅ 测试1-1通过 - serendipity讲解成功");
        client.log("📝 AI响应长度: " + response.body.data.message.length + " 字符");
        client.global.set("conversation_id_1", response.body.data.conversationId);
    });
%}

###

# Name: 测试1-2: 单词讲解 - ephemeral
# Method: POST
# Description: 测试AI单词讲解功能 - 另一个单词
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "ephemeral是什么意思？请给出例句",
  "conversationId": "",
  "mode": "word_inquiry",
  "targetWord": "ephemeral"
}

> {%
    client.test("验证AI响应", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.message !== null, "AI消息不应为空");
        client.log("✅ 测试1-2通过 - ephemeral讲解成功");
        client.global.set("conversation_id_2", response.body.data.conversationId);
    });
%}

###

# Name: 测试1-3: 单词讲解 - epiphany
# Method: POST
# Description: 测试AI单词讲解功能 - 第三个单词
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "Can you explain the word 'epiphany'?",
  "conversationId": "",
  "mode": "word_inquiry",
  "targetWord": "epiphany"
}

> {%
    client.test("验证AI响应", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.message !== null, "AI消息不应为空");
        client.log("✅ 测试1-3通过 - epiphany讲解成功");
        client.global.set("conversation_id_3", response.body.data.conversationId);
    });
%}

###

### ============================================================================
### 2. AI对话接口 - Word Training模式（场景训练）
### ============================================================================
# Name: 测试2-1: 场景训练 - ephemeral
# Method: POST
# Description: 测试AI场景训练功能
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "Let's practice!",
  "conversationId": "",
  "mode": "word_training",
  "targetWord": "ephemeral",
  "scenario": "You're at a coffee shop talking about social media trends with a friend."
}

> {%
    client.test("验证训练模式响应", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.message !== null, "AI消息不应为空");
        client.assert(response.body.data.message.length > 20, "AI响应应该足够详细");
        client.log("✅ 测试2-1通过 - ephemeral训练模式成功");
        client.log("🎬 场景训练响应: " + response.body.data.message.substring(0, 100) + "...");
        client.global.set("training_conversation_id", response.body.data.conversationId);
    });
%}

###

# Name: 测试2-2: 多轮对话训练
# Method: POST
# Description: 测试在训练模式下的多轮对话
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "I think ephemeral trends make us appreciate lasting things more.",
  "conversationId": "{{training_conversation_id}}",
  "mode": "word_training",
  "targetWord": "ephemeral",
  "scenario": "You're at a coffee shop talking about social media trends."
}

> {%
    client.test("验证多轮对话响应", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.message !== null, "AI消息不应为空");
        client.log("✅ 测试2-2通过 - 多轮对话训练成功");
        client.log("💬 AI回复: " + response.body.data.message.substring(0, 80) + "...");
    });
%}

###

### ============================================================================
### 3. AI对话接口 - 多轮对话测试（带对话历史）
### ============================================================================
# Name: 测试3-1: 继续对话 - 使用conversationId
# Method: POST
# Description: 测试带对话历史的多轮对话
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "Can you give me more examples?",
  "conversationId": "{{conversation_id_1}}",
  "mode": "word_inquiry",
  "targetWord": "serendipity"
}

> {%
    client.test("验证多轮对话响应", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.conversationId === client.global.get("conversation_id_1"), "ConversationId应该保持一致");
        client.log("✅ 测试3-1通过 - 多轮对话成功");
    });
%}

###

### ============================================================================
### 4. 获取对话历史接口
### ============================================================================
# Name: 测试4-1: 获取对话历史 - 通过conversationId
# Method: GET
# Description: 根据对话ID获取完整对话记录
GET http://localhost:8885/api/ai/conversations/{{conversation_id_1}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("验证获取对话历史", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data !== null, "对话数据不应为空");
        client.assert(response.body.data.conversationId === client.global.get("conversation_id_1"), "ConversationId应该匹配");
        client.log("✅ 测试4-1通过 - 获取对话历史成功");
        client.log("📊 对话轮数: " + (response.body.data.messages ? JSON.parse(response.body.data.messages).length : 0));
    });
%}

###

# Name: 测试4-2: 获取对话历史 - 不存在的ID
# Method: GET
# Description: 测试获取不存在的对话历史
GET http://localhost:8885/api/ai/conversations/non-existent-id
Authorization: Bearer {{auth_token}}

> {%
    client.test("验证错误处理", function() {
        client.assert(response.body.code === 404, "不存在的对话应返回404");
        client.log("✅ 测试4-2通过 - 正确处理不存在的对话ID");
    });
%}

###

### ============================================================================
### 5. 获取对话列表接口
### ============================================================================
# Name: 测试5-1: 获取对话列表
# Method: GET
# Description: 获取当前用户的所有对话记录
GET http://localhost:8885/api/ai/conversations
Authorization: Bearer {{auth_token}}

> {%
    client.test("验证获取对话列表", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data !== null, "对话列表不应为空");
        client.assert(Array.isArray(response.body.data), "返回数据应该是数组");
        client.log("✅ 测试5-1通过 - 获取对话列表成功");
        client.log("📊 对话数量: " + response.body.data.length);
    });
%}

###

# Name: 测试5-2: 获取对话列表 - 分页参数
# Method: GET
# Description: 测试带分页参数的对话列表
GET http://localhost:8885/api/ai/conversations?page=0&size=5
Authorization: Bearer {{auth_token}}

> {%
    client.test("验证分页参数", function() {
        client.assert(response.body.code === 200, "响应码应为200");
        client.assert(response.body.data.length <= 5, "返回数量不应超过size参数");
        client.log("✅ 测试5-2通过 - 分页参数生效");
    });
%}

###

### ============================================================================
### 6. 权限测试 - 未授权访问
### ============================================================================
# Name: 测试6-1: 未提供Token
# Method: POST
# Description: 测试未提供Token的情况
POST http://localhost:8885/api/ai/chat
Content-Type: application/json

{
  "message": "hello",
  "mode": "word_inquiry"
}

> {%
    client.test("验证未授权访问", function() {
        client.assert(response.body.code === 401, "未授权应返回401");
        client.log("✅ 测试6-1通过 - 正确处理未授权访问");
    });
%}

###

# Name: 测试6-2: 无效的Token
# Method: POST
# Description: 测试提供无效Token的情况
POST http://localhost:8885/api/ai/chat
Authorization: Bearer invalid_token_12345
Content-Type: application/json

{
  "message": "hello",
  "mode": "word_inquiry"
}

> {%
    client.test("验证无效Token", function() {
        client.assert(response.body.code === 401, "无效Token应返回401");
        client.log("✅ 测试6-2通过 - 正确处理无效Token");
    });
%}

