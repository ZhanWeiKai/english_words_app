### ============================================================================
### 8. 性能测试
### ============================================================================
# Name: 测试8-1: 响应时间测试
# Method: POST
# Description: 测试AI响应时间
POST http://localhost:8885/api/ai/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "hello",
  "conversationId": "",
  "mode": "word_inquiry"
}

> {%
    client.test("验证响应时间", function() {
        const responseTime = response.responseTime;
        client.log("⏱️  响应时间: " + responseTime + " ms");
        client.assert(responseTime < 30000, "响应时间应在30秒内");
        client.log("✅ 测试8-1通过 - 响应时间可接受");
    });
%}

