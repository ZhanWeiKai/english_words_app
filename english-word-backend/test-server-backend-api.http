### 用户登录
POST http://119.91.206.195:8885/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456"
}

> {%
    client.global.set("token", response.body.data.token);
%}

###
POST http://119.91.206.195:8885/api/ai/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "message": "test test",
  "conversationId": null
}

### =============================================
### ASR 语音识别测试（远程服务器）
### =============================================

### 语音识别 - 上传音频文件
POST http://119.91.206.195:8885/api/asr/recognize
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="hello_world_female2.wav"
Content-Type: audio/wav

< ./abc.wav
--WebAppBoundary
Content-Disposition: form-data; name="language"

zh
--WebAppBoundary--

### 语音识别 - 英文音频（自动检测语言）
POST http://119.91.206.195:8885/api/asr/recognize
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="hello_world_female2.wav"
Content-Type: audio/wav

< ./abc.wav

###
POST http://119.91.206.195:8885/api/tts/synthesize?text=Hello! 👋 How can I help you with your Englis
Authorization: Bearer {{token}}


###
POST http://119.91.206.195:8885/api/ai/chat/stream
Content-Type: application/json
Authorization: Bearer {{token}}
Accept: text/event-stream

{
  "message": "你好",
  "conversationId": null
}

### =============================================
### 句子管理测试 (Sentence) - REST API CRUD
### =============================================

### 添加句子（REST API 直接调用）
# @name addSentence
POST http://119.91.206.195:8885/api/sentences
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "englishText": "The early bird catches the worm.",
  "chineseText": "早起的鸟儿有虫吃。",
  "markedWords": "bird, worm"
}

> {%
    if (response.body.data && response.body.data.id) {
        client.global.set("sentenceId", response.body.data.id);
    }
%}

### 添加句子 2
POST http://119.91.206.195:8885/api/sentences
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "englishText": "Practice makes perfect.",
  "chineseText": "熟能生巧。",
  "markedWords": "practice, perfect"
}

### 添加句子 3
POST http://119.91.206.195:8885/api/sentences
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "englishText": "Actions speak louder than words.",
  "chineseText": "事实胜于雄辩。",
  "markedWords": "actions, words"
}

### 获取句子列表（分页）
GET http://119.91.206.195:8885/api/sentences?page=0&size=20
Authorization: Bearer {{token}}

### 搜索句子（关键词搜索英文/中文）
GET http://119.91.206.195:8885/api/sentences?keyword=bird&page=0&size=20
Authorization: Bearer {{token}}

### 获取句子分页信息（包含总数、总页数）
GET http://119.91.206.195:8885/api/sentences/page?page=0&size=10
Authorization: Bearer {{token}}

### 获取句子统计
GET http://119.91.206.195:8885/api/sentences/statistics
Authorization: Bearer {{token}}

### 获取句子详情
GET http://119.91.206.195:8885/api/sentences/{{sentenceId}}
Authorization: Bearer {{token}}

### 更新句子
PUT http://119.91.206.195:8885/api/sentences/{{sentenceId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "englishText": "The early bird catches the worm.",
  "chineseText": "早起的鸟儿有虫吃。（更新）",
  "markedWords": "early, bird, worm"
}

### 删除句子
DELETE http://119.91.206.195:8885/api/sentences/{{sentenceId}}
Authorization: Bearer {{token}}

### =============================================
### 通过 AI Chat 测试句子收藏 (MCP Tool)
### =============================================

### AI聊天 - 收藏句子（通过 AI 调用 add_sentence MCP Tool）
POST http://119.91.206.195:8885/api/ai/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "message": "收藏这个句子：Where there is a will, there is a way. 有志者事竟成。",
  "conversationId": null
}

### AI聊天 - 查看我收藏的句子
POST http://119.91.206.195:8885/api/ai/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "message": "我收藏了哪些句子？",
  "conversationId": null
}

### AI聊天 - 删除句子（通过 AI 调用 delete_sentence MCP Tool）
POST http://119.91.206.195:8885/api/ai/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "message": "删除句子 {{sentenceId}}",
  "conversationId": null
}
