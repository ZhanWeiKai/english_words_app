### 用户登录
POST http://119.91.206.195:8885/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456"
}

> {%
    // 从返回 JSON 中提取 token
    const json = JSON.parse(response.body);
    client.global.set("token", response.body.data.token);
%}

###
POST http://119.91.206.195:8885/api/ai/chat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "message": "帮我添加family",
  "conversationId": null
}

### =============================================
### ASR 语音识别测试（远程服务器）
### =============================================

### 语音识别 - 上传音频文件
POST http://119.91.206.195:8885/api/asr/recognize
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="hello_world_female2.wav"
Content-Type: audio/wav

< ./abc.wav
--WebAppBoundary
Content-Disposition: form-data; name="language"

zh
--WebAppBoundary--

### 语音识别 - 英文音频（自动检测语言）
POST http://119.91.206.195:8885/api/asr/recognize
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="hello_world_female2.wav"
Content-Type: audio/wav

< ./abc.wav
